# Copy to .env and adjust. Local dev defaults to SQLite + eager Celery when
# these are unset, so you can run `manage.py runserver` with zero infra.

DJANGO_SETTINGS_MODULE=config.settings.dev
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=true

# Postgres (omit to fall back to SQLite)
# POSTGRES_HOST=localhost
# POSTGRES_DB=queryengine
# POSTGRES_USER=queryengine
# POSTGRES_PASSWORD=queryengine

# Redis (omit to run Celery tasks eagerly + skip the stats cache)
# REDIS_URL=redis://localhost:6379/0

# Object storage (MinIO / S3). Omit to read datasets from local paths.
# AWS_ENDPOINT_URL=http://localhost:9000
# AWS_ACCESS_KEY_ID=minioadmin
# AWS_SECRET_ACCESS_KEY=minioadmin
# AWS_REGION=us-east-1

# Engine
# ENGINE_MAX_WORKERS=4
